# 容器字面量：Tuple/Dict/Set 的打印与成员测试，以及 List/字符串切片。

val point = (1, 2)
# Dict 用 {: ... :}，Set 用 {. ... .}；Tuple 用 (a, b)。
val d = {:
    "a": 1,
    "b": 2,
:}
val s = {. 1, 2, 3 .}

print(point)
print(d)
print(len(s), 2 in s)

# 切片：返回新的 List / String；[::2] 指定步长。
print([1, 2, 3, 4][1:3])
print("hello"[1:])
print([0, 1, 2, 3, 4][::2])
