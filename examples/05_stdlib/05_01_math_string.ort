# 原生模块 math/string：数学函数与常量；string 的 join/split/upper 等与 from 导入。

import "math"
import "string"
from "string" import upper

print(math.floor(math.sqrt(10)))          # 3
print(math.pi > 3.14)                     # true
print(string.join(["a", "b"], "-"))      # a-b
print(upper("oort"))                      # OORT（from 导入）
print(string.split("a,b,c", ","))        # [a, b, c]
print(string.startswith("oort", "oo"))   # true
