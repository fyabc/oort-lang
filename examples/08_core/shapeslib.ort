#lang oort-core

# 08_12 的导入目标。跨模块类型接口的要点：
# - 类实体同时占据值命名空间（构造器 Shape(...)）与类型命名空间（Shape）。
# - enum 的构造器（Red / Leaf）是值；enum 类型名（Color / Tree）只存在于
#   类型命名空间，没有运行时值。
# - 类型导出只包含本模块自己声明的类型：预置 Option/Result 与导入名不再导出。

class Shape {
    val name: String

    def __init__(name: String) {
        this.name = name
    }

    def label() -> String {
        this.name
    }
}

enum Color {
    Red,
    Green,
    Blue
}

enum Tree[T] {
    Leaf(value: T),
    Node(left: Tree[T], right: Tree[T])
}
