#lang oort-core

# 标量：Float/String、数值混合运算与严格标注。

# `/` 固定返回 Float；`//` 在 Int 之间保持 Int，混入 Float 时为 Float。
val half: Float = 5 / 2
val whole: Int = 5 // 2
val mixed_floor: Float = 5 // 2.0
val greeting: String = "Hello, " + "Oort"

def average(a: Float, b: Float) -> Float {
    (a + b) / 2.0
}

print(half)
print(whole, mixed_floor)
print(average(1.0, 2.0))
print(greeting)
# Int 与 Float 值相等；String 按字典序比较。
print(1 == 1.0, "a" < "b")
