#lang oort-core

# typed 函数值：命名函数与 lambda 作为一等值，支持高阶参数/返回、容器存储
# 与捕获闭包；被捕获的变量按引用共享（单元格），内部写入与创建后再赋值
# 对闭包和创建者都可见。

def inc(x: Int) -> Int { x + 1 }
def dec(x: Int) -> Int { x - 1 }

def apply(f: (Int) -> Int, x: Int) -> Int { f(x) }

def pick(flag: Bool) -> (Int) -> Int {
    if flag { inc } else { dec }
}

def local() -> Int {
    val f: (Int) -> Int = inc
    f(10)
}

def sum_apply(fs: List[(Int) -> Int], x: Int) -> Int {
    var total = 0
    for f in fs { total = total + f(x) }
    total
}

# Dict 作为函数分派表：函数类型嵌套在容器值位置。
def dispatch(op: String, x: Int) -> Int {
    val table: Dict[String, (Int) -> Int] = {: "inc": inc, "dec": dec :}
    val f = table[op]
    f(x)
}

# 非捕获 lambda：运行时构造新函数（如这里的 double/triple）。
# lambda 的返回类型由 val 标注的期望函数类型下推，可省略。
def with_lambda() -> Int {
    val double: (Int) -> Int = do(x: Int) { x * 2 }
    double(21)
}

def lambda_arg() -> Int {
    apply(do(x: Int) -> Int { x + 10 }, 5)
}

def compose_style() -> Int {
    val f: (Int) -> Int = do(x: Int) -> Int { apply(do(y: Int) -> Int { y * 3 }, x) }
    f(4)
}

# 捕获闭包：lambda 读取外层变量，捕获的是变量单元格而非快照。
# 循环体每轮为循环变量新建单元格，因此各闭包持有当轮的值。
def make_adder(n: Int) -> (Int) -> Int {
    do(x: Int) -> Int { x + n }
}

def loop_capture() -> Int {
    var total = 0
    for i in [10, 20, 30] {
        val g = do(x: Int) -> Int { x + i }
        total = total + g(1)
    }
    total
}

def use_adder() -> Int {
    val add10 = make_adder(10)
    add10(5)
}

# 共享写入：闭包释放后仍可反复推进计数器。
def counter() -> () -> Int {
    var n = 0
    do() -> Int { n = n + 1; n }
}

def use_counter() -> Int {
    val c = counter()
    c() + c() + c()
}

# 创建闭包后再赋值：闭包看到的是最新的值，而不是快照。
def reassign_after_capture() -> Int {
    var k = 1
    val f = do(x: Int) -> Int { x + k }
    k = 2
    f(10)
}

# 闭包内写回外层变量：创建者也能看到累计结果。
def accumulator() -> Int {
    var sum = 0
    val add = do(v: Int) -> Unit { sum = sum + v }
    add(1)
    add(20)
    add(300)
    sum
}

print(apply(inc, 1), apply(dec, 1))
print(apply(pick(true), 2), apply(pick(false), 2))
print(local())
print(sum_apply([inc, dec], 10))
print(dispatch("inc", 6), dispatch("dec", 6))
print(with_lambda(), lambda_arg(), compose_style())
print(use_adder(), loop_capture())
print(use_counter(), reassign_after_capture(), accumulator())
