#lang oort-core

# 泛型 ADT：用户定义的泛型 enum + 内建 Option。
# 类型参数在 HIR/字节码前擦除；match 按实参代换载荷类型。

enum Maybe[T] {
    Just(value: T),
    Nothing
}

enum MyList[T] {
    Cons(head: T, tail: MyList[T]),
    Nil
}

def unwrap(o: Option[Int], fallback: Int) -> Int {
    match o {
        Some(v) => v,
        None => fallback
    }
}

def total(xs: MyList[Int]) -> Int {
    match xs {
        Cons(h, t) => h + total(t),
        Nil => 0
    }
}

val some: Option[Int] = Some(3)
val none: Option[Int] = None
val xs: MyList[Int] = Cons(1, Cons(2, Nil))
val maybe: Maybe[String] = Just("gap")

print(unwrap(some, 0))
print(unwrap(none, -1))
print(total(xs))
print(match Some("text") { Some(v) => v, None => "" })
print(match maybe { Just(v) => v, Nothing => "" })
print(match Just(7) { Just(v) => v, Nothing => 0 })
