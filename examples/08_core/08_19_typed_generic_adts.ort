#lang oort-core

# 类型化 IR 子集（S4b）：泛型 ADT 与内建 Option。
# - 泛型类型参数进入静态类型与类型表，运行时作为 ADT 实例身份保留；
# - 用户泛型 enum 与 prelude Option[Int] 都走 typed ADT 路径；
# - 构造器类型实参由期望类型或实参类型推断。

enum Maybe[T] {
    Just(value: T),
    Nothing,
}

def maybe_or(value: Maybe[Int], fallback: Int) -> Int {
    match value {
        Just(v) => v,
        Nothing => fallback,
    }
}

def option_or(value: Option[Int], fallback: Int) -> Int {
    match value {
        Some(v) => v,
        None => fallback,
    }
}

print(maybe_or(Just(7), 0))
print(maybe_or(Nothing, 9))
print(option_or(Some(3), 9), option_or(None, 9))
print(maybe_or(Just(3), 9) + option_or(None, 4))
