#lang oort-core

# 集合字面量自动推断类型；空字面量由标注提供期望类型。随后演示 for/while。

val xs = [3, 1, 2]                  # List[Int]
val pair = (7, true)                # Tuple[Int, Bool]
val scores = {: "a": 1, "b": 2 :}   # Dict[String, Int]
val tags = {. "core", "static" .}   # Set[String]
val empty: List[Int] = []           # 空 List 需要标注

def total(values: List[Int]) -> Int {
    var sum = 0
    for value in values {
        sum = sum + value
    }
    sum
}

print(xs[0], len(xs), len(empty))
print(pair[0], pair[1], len(pair))
print(scores["b"], len(scores), len(tags))
print(total(xs))

for key in scores {
    print(key, scores[key])
}

for ch in "oort" {
    print(ch)
}

var i = 0
while i < 4 {
    i = i + 1
    if i == 2: continue
    if i == 4: break
    print(i)
}
