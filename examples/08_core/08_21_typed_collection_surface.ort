#lang oort-core

# core 集合表面（OP 0031）：成员测试、List/Dict 下标写入、
# 切片读取（List/Tuple/String）、Set 代数与子集/超集比较。

def mutate() -> Int {
    var xs: List[Int] = [1, 2, 3]
    xs[0] = 9
    xs[0]
}

def table() -> Int {
    var scores: Dict[String, Int] = {: "a": 1 :}
    scores["b"] = 2
    scores["a"] + scores["b"]
}

def windows() -> String {
    var text: String = "oort"
    text[1:3] + text[-1:]
}

print(2 in [1, 2], "or" in "oort", "a" in {: "a": 1 :}, 3 !in [1, 2])
print(mutate(), table(), windows())
print([1, 2, 3, 4][1:3], (1, "a", true)[1:])
print({. 1, 2 .} | {. 2, 3 .}, {. 1, 2 .} & {. 2, 3 .})
print({. 1, 2 .} - {. 2 .}, {. 1, 2 .} ^ {. 2, 3 .})
print({. 1, 2 .} <= {. 1, 2, 3 .}, {. 1, 2 .} < {. 1, 2, 3 .}, {. 1, 2, 3 .} > {. 1, 2 .})
