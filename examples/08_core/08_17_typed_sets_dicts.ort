#lang oort-core

# 类型化 IR 子集（S3）：Dict / Set 字面量、下标、len、相等与 for 迭代。
# Dict 保持插入顺序；Set 的迭代/打印顺序不属于语言保证。

def dict_total(scores: Dict[String, Int]) -> Int {
    var total: Int = 0
    for key in scores { total = total + scores[key] }
    total
}

def set_total(values: Set[Int]) -> Int {
    var total: Int = 0
    for value in values { total = total + value }
    total
}

def empty_dict_len() -> Int {
    var scores: Dict[String, Int] = {: :}
    len(scores)
}

def empty_set_len() -> Int {
    var values: Set[Int] = {. .}
    len(values)
}

print({: "a": 1, "b": 2, "c": 3 :}["b"], len({: "a": 1, "b": 2, "c": 3 :}))
print(dict_total({: "a": 1, "b": 2, "c": 3 :}))
print(set_total({. 2, 4, 6 .}), len({. 2, 4, 6 .}))
print(empty_dict_len(), empty_set_len())
print({: "a": 1, "b": 2 :} == {: "a": 1, "b": 2 :})
print({. 2, 4, 6 .} == {. 6, 4, 2 .})
print({: "x": (1, true) :})
