{
  // Rust workspace lives in rust/ (repo root is a Python project, no root
  // Cargo.toml), so point rust-analyzer at it explicitly.
  "rust-analyzer.linkedProjects": ["rust/Cargo.toml"],

  // Rust is installed under <tools-dir> (not on the system PATH). Tell the
  // rust-analyzer server and its cargo invocations where rustup/cargo live.
  "rust-analyzer.server.extraEnv": {
    "RUSTUP_HOME": "<rustup-home>",
    "CARGO_HOME": "<cargo-home>",
    "PATH": "<cargo-bin-dir>;${env:PATH}"
  },
  "rust-analyzer.cargo.extraEnv": {
    "RUSTUP_HOME": "<rustup-home>",
    "CARGO_HOME": "<cargo-home>",
    "PATH": "<cargo-bin-dir>;${env:PATH}"
  },

  // Keep rust-analyzer's check command consistent with the spike build.
  "rust-analyzer.check.command": "clippy"
}
