# Continuation line
1 +\
2

# (), [], {: :}, {. .}
(1 +
2)

[1,
2]

{: 3 +
4: "x" :}

{. 5 +
6 .}

# {} inside ()
print(do {
    2
    3
})

# () inside {}
do {
    (7 +
    8)
}

# ({{}})
print(9 +
    10, do {
    do {
        2
        3
    }
})

# {({})}
do {
    1
    2
    print(11 +
    12, do {
    })
}
