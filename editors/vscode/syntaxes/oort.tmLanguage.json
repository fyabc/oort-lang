{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Oort",
  "scopeName": "source.oort",
  "patterns": [
    { "include": "#lang-directive" },
    { "include": "#operator-method" },
    { "include": "#def-name" },
    { "include": "#class-name" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#import-keywords" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#container-punctuation" },
    { "include": "#ellipsis" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "lang-directive": {
      "match": "^(#lang)(?:[ \\t]+([A-Za-z][A-Za-z0-9_-]*))?[ \\t]*$",
      "captures": {
        "1": { "name": "keyword.other.directive.oort" },
        "2": { "name": "support.constant.dialect.oort" }
      }
    },
    "operator-method": {
      "comment": "Operator method name: def operator \"+\"(other)",
      "match": "(\\bdef[ \\t]+)(operator)([ \\t]+)(\"[^\"\\n]*\"|'[^'\\n]*')",
      "captures": {
        "1": { "name": "storage.type.oort" },
        "2": { "name": "keyword.other.operator.oort" },
        "4": { "name": "entity.name.function.operator.oort" }
      }
    },
    "def-name": {
      "match": "(\\bdef[ \\t]+)((?:(?:class|[\\p{L}_][\\p{L}\\p{N}_]*!?)\\.)*)([\\p{L}_][\\p{L}\\p{N}_]*!?)",
      "captures": {
        "1": { "name": "storage.type.oort" },
        "2": { "name": "entity.name.namespace.oort" },
        "3": { "name": "entity.name.function.oort" }
      }
    },
    "class-name": {
      "match": "(\\bclass[ \\t]+)([\\p{L}_][\\p{L}\\p{N}_]*!?)",
      "captures": {
        "1": { "name": "storage.type.oort" },
        "2": { "name": "entity.name.type.oort" }
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.oort",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.oort" }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#string-raw-triple" },
        { "include": "#string-raw-single" },
        { "include": "#string-triple" },
        { "include": "#string-single" }
      ]
    },
    "string-raw-triple": {
      "name": "string.quoted.triple.raw.oort",
      "begin": "((?:[rR][fF]?|[fF][rR]))(\"\"\"|''')",
      "beginCaptures": {
        "1": { "name": "storage.type.string.prefix.oort" },
        "2": { "name": "punctuation.definition.string.begin.oort" }
      },
      "end": "\\2",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.oort" }
      }
    },
    "string-raw-single": {
      "name": "string.quoted.single.raw.oort",
      "begin": "((?:[rR][fF]?|[fF][rR]))(\"|')",
      "beginCaptures": {
        "1": { "name": "storage.type.string.prefix.oort" },
        "2": { "name": "punctuation.definition.string.begin.oort" }
      },
      "end": "\\2",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.oort" }
      }
    },
    "string-triple": {
      "name": "string.quoted.triple.oort",
      "begin": "([fF]?)(\"\"\"|''')",
      "beginCaptures": {
        "1": { "name": "storage.type.string.prefix.oort" },
        "2": { "name": "punctuation.definition.string.begin.oort" }
      },
      "end": "\\2",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.oort" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.oort",
      "begin": "([fF]?)(\"|')",
      "beginCaptures": {
        "1": { "name": "storage.type.string.prefix.oort" },
        "2": { "name": "punctuation.definition.string.begin.oort" }
      },
      "end": "\\2",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.oort" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.oort",
      "match": "\\\\."
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|0[dD][0-9]+|(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|[0-9]+))\\b",
      "name": "constant.numeric.oort"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oort",
          "match": "\\b(?:if|elif|else|for|while|break|continue|return|yield|await)\\b"
        },
        {
          "name": "keyword.operator.word.oort",
          "match": "\\b(?:and|or|not|in|is)\\b"
        },
        {
          "name": "storage.type.oort",
          "match": "\\b(?:var|val|def|class|macro)\\b"
        },
        {
          "name": "variable.language.oort",
          "match": "\\b(?:this|super)\\b"
        },
        {
          "name": "constant.language.oort",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "keyword.other.soft.oort",
          "match": "\\b(?:operator|infix)\\b"
        }
      ]
    },
    "import-keywords": {
      "name": "keyword.control.import.oort",
      "match": "\\b(?:import|from|as)\\b"
    },
    "builtin-types": {
      "name": "support.type.builtin.oort",
      "match": "\\b(?:Object|Type|Function|Method|SuperProxy|Null|Int|Bool|Float|String|List|Tuple|Dict|Set|Slice)\\b"
    },
    "container-punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.dict.empty.oort",
          "match": "\\{:\\}"
        },
        {
          "name": "punctuation.section.set.empty.oort",
          "match": "\\{\\.\\}"
        },
        {
          "name": "punctuation.section.dict.begin.oort",
          "match": "\\{:"
        },
        {
          "name": "punctuation.section.dict.end.oort",
          "match": ":\\}"
        },
        {
          "name": "punctuation.section.set.begin.oort",
          "match": "\\{\\."
        },
        {
          "name": "punctuation.section.set.end.oort",
          "match": "\\.\\}"
        }
      ]
    },
    "ellipsis": {
      "name": "constant.language.ellipsis.oort",
      "match": "\\.\\.\\."
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.oort",
          "match": "(?:\\*\\*=|//=|<<=|>>=|[+\\-*/%&|^]=|=)"
        },
        {
          "name": "keyword.operator.oort",
          "match": "\\*\\*|//|<<|>>|<=|>=|==|!=|!in|!is|->|::|[!%&*+\\-<=>?^|~]+"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.oort",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.oort",
          "match": "[,;]"
        },
        {
          "name": "punctuation.separator.colon.oort",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.oort",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.annotation.oort",
          "match": "@"
        }
      ]
    }
  }
}
